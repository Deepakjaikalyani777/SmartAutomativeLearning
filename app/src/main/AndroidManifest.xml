<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      1) FEATURE FLAGS
      android.hardware.type.automotive marks this as an Android Automotive OS (AAOS) app.
      required="false" lets the SAME APK also install on phones/emulators so you can learn
      without an AAOS image. Production AAOS apps usually set required="true".
    -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <!-- AAOS apps must not *require* hardware a car head unit does not have. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      2) CAR PERMISSIONS (protection levels matter in interviews!)
      CAR_SPEED      -> dangerous: user must grant at runtime
      CAR_INFO       -> normal:    granted at install (make, model, fuel type...)
      CAR_ENERGY     -> dangerous (Android 14+): fuel / battery level
      CAR_POWERTRAIN -> normal:    gear, ignition, parking brake
      CAR_EXTERIOR_ENVIRONMENT -> normal: outside temperature, night mode
      CONTROL_CAR_CLIMATE -> signature|privileged: only OEM/system apps can change HVAC.
    -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".AutomotiveApp"
        android:allowBackup="false"
        android:appCategory="audio"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Automotive">

        <!-- The Car API is part of the AAOS platform. required=false = optional on phones. -->
        <uses-library android:name="android.car" android:required="false" />

        <!-- Tells Android Auto / AAOS which car capabilities this app provides. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Minimum Car App API level our Car App Library screens need. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!--
          3) THE LEARNING APP (Jetpack Compose).
          distractionOptimized=true declares that this activity follows Driver Distraction
          guidelines and may stay visible while the car moves. AAOS only honours it for
          system / pre-installed apps; third-party apps must use Car App Library templates.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!--
          4) MEDIA: a MediaBrowserService is how media apps plug into the car's
          built-in media UI (AAOS Media Center and Android Auto). The OEM draws the UI;
          we only supply the content tree + a MediaSession.
        -->
        <service
            android:name=".media.CarMediaBrowserService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          5) CAR APP LIBRARY: template-based UI for POI (charging/parking), navigation and IoT apps.
          The host (Android Auto or AAOS) renders templates - so they are automatically
          distraction-optimized and styled by the OEM.
        -->
        <service
            android:name=".carapp.ChargingStationCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.CHARGING" />
            </intent-filter>
        </service>
    </application>
</manifest>
